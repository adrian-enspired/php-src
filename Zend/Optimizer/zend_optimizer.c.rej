 	zend_class_entry *ce = script ? zend_hash_find_ptr(&script->class_table, lcname) : NULL;
 	if (ce) {
-		return ce;
+		/* PHP Modules: never hand back a class the accessor could not reach at runtime. */
+		return zend_optimizer_module_class_usable(script, ce, op_array) ? ce : NULL;
